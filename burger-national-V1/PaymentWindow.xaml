<Window x:Class="burger_national_V1.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:burger_national_V1"
        mc:Ignorable="d"
        Title="Payment" Height="477" Width="800" Background="#FF0E0E0E">
    <Grid Margin="0,0,0,-6">
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/burger-national-logo.png" Stretch="UniformToFill" Opacity="0.5"/>
        </Grid.Background>
        <Label Content="Total" FontSize="48" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="162,55,0,0" VerticalAlignment="Top" Width="228" FontWeight="Bold" Height="69" RenderTransformOrigin="0.486,0.166" FontFamily="Bahnschrift" Background="#00000000" Foreground="FloralWhite"/>
        <TextBox x:Name="txtTotalPrice" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  Margin="414,52,0,0" TextWrapping="Wrap" Text="$0.00" VerticalAlignment="Top" Width="204" Height="72" IsReadOnly="True" FontSize="48" TextAlignment="Center" Background="{x:Null}" Foreground="FloralWhite" BorderBrush="DarkRed" Padding="5,5,5,5" FontFamily="Bahnschrift"/>

        <Button x:Name="btnEftpos" Click="btnEftpos_Click" Content="EFTPOS" HorizontalAlignment="Left" Margin="47,139,0,0" VerticalAlignment="Top" Height="88" Width="169" FontSize="24" Foreground="FloralWhite" FontFamily="Bahnschrift">
            <Button.Background>
                <SolidColorBrush Color="#FF3406B9" Opacity="0.75"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnExactAmount" Click="btnExactAmount_Click" Content="Exact" HorizontalAlignment="Left" Margin="47,235,0,0" VerticalAlignment="Top" Height="88" Width="169" FontSize="24" Foreground="FloralWhite" FontFamily="Bahnschrift">
            <Button.Background>
                <SolidColorBrush Color="#FF585858" Opacity="0.75"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnCash" Click="btnCash_Click" Content="Cash" HorizontalAlignment="Left" Margin="504,355,0,0" VerticalAlignment="Top" Height="88" Width="170" FontSize="24" Foreground="White" FontFamily="Bahnschrift">
            <Button.Background>
                <SolidColorBrush Color="#FF0ACA39" Opacity="0.75"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnHundredDollars" Click="btnHundredDollars_Click" HorizontalAlignment="Left" Margin="395,235,0,0" VerticalAlignment="Top" Height="88" Width="169">
            <Button.Background>
                <ImageBrush ImageSource="/Assets/Images/Money/One Hundred.jpg" Opacity="0.75"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnFiftyDollars" Click="btnFiftyDollars_Click" HorizontalAlignment="Left" Margin="221,235,0,0" VerticalAlignment="Top" Height="88" Width="169">
            <Button.Background>
                <ImageBrush ImageSource="/Assets/Images/Money/Fifty.jpg" Opacity="0.75"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnTwentyDollars" Click="btnTwentyDollars_Click" HorizontalAlignment="Left" Margin="569,142,0,0" VerticalAlignment="Top" Height="88" Width="169">
            <Button.Background>
                <ImageBrush ImageSource="/Assets/Images/Money/Twenty.jpg" Opacity="0.75"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnTenDollars" Click="btnTenDollars_Click" HorizontalAlignment="Left" Margin="395,142,0,0" VerticalAlignment="Top" Height="88" Width="169">
            <Button.Background>
                <ImageBrush ImageSource="/Assets/Images/Money/Ten.jpg" Opacity="0.75"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnFiveDollars" Click="btnFiveDollars_Click" HorizontalAlignment="Left" Margin="221,142,0,0" VerticalAlignment="Top" Height="88" Width="169">
            <Button.Background>
                <ImageBrush ImageSource="/Assets/Images/Money/Five.jpg" Opacity="0.75"/>
            </Button.Background>
        </Button>
        <Label Content="Pay Cash:" FontSize="36" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="144,355,0,0" VerticalAlignment="Top" Width="180" FontWeight="Bold" Height="88" RenderTransformOrigin="0.486,0.166" FontFamily="Bahnschrift" Background="#00000000" Foreground="FloralWhite" />
        <TextBox x:Name="txtCash" HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"  Margin="329,355,0,0" TextWrapping="Wrap" Text="0.00" VerticalAlignment="Top" Width="170" Height="88" IsReadOnly="False" FontSize="48" TextAlignment="Center" Background="{x:Null}" Foreground="FloralWhite" BorderBrush="DarkRed" Padding="5,5,5,5" FontFamily="Bahnschrift" />

    </Grid>
</Window>
