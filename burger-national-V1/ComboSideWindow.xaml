<Window x:Class="burger_national_V1.ComboSideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:burger_national_V1"
        mc:Ignorable="d"
        Title="Combo Side" Height="555" Width="800">
    <Grid>
        <Button x:Name="btnFries" Content="Fries" Click="btnFries_Click" Margin="96,72,508,267" Height="200" Grid.RowSpan="2" FontFamily="Bahnschrift" BorderBrush="#FFCCCCCC" Foreground="FloralWhite" FontWeight="Bold"/>
        <Button x:Name="btnGarlicBread" Content="Garlic Bread" Click="btnGarlicBread_Click" Margin="297,72,307,267" Height="200" Grid.RowSpan="2" FontFamily="Bahnschrift" BorderBrush="#FFCCCCCC" Foreground="FloralWhite" FontWeight="Bold"/>
        <Button x:Name="btnMozzarellaStick" Content="Mozzarella Stick" Click="btnMozzarellaStick_Click" Margin="498,72,106,267" Height="200" Grid.RowSpan="2" FontFamily="Bahnschrift" BorderBrush="#FFCCCCCC" Foreground="FloralWhite" FontWeight="Bold"/>
        <Button x:Name="btnSpringRoll" Content="Spring Roll" Click="btnSpringRoll_Click" Margin="96,277,508,62" Height="200" FontSize="20" FontFamily="Bahnschrift" BorderBrush="#FFCCCCCC" Foreground="FloralWhite" FontWeight="Bold"/>
        <Button x:Name="btnLoadedNachos" Content="Loaded Nachos" Click="btnLoadedNachos_Click" Margin="297,277,307,62" Height="200" FontSize="20" FontFamily="Bahnschrift" BorderBrush="#FFCCCCCC" Foreground="FloralWhite" FontWeight="Bold"/>
        <Button x:Name="btnPoutine" Content="Poutine" Click="btnPoutine_Click" Margin="498,277,106,62" Height="200" FontSize="20" FontFamily="Bahnschrift" BorderBrush="#FFCCCCCC" Foreground="FloralWhite" FontWeight="Bold"/>
    </Grid>
</Window>
