<Window x:Class="burger_national_V1.BurgerChoiceWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:burger_national_V1"
      mc:Ignorable="d"
        Title="Which Burger Do You Want?" Height="450" Width="800" Background="#FF212121">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/burger-national-logo.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <Label Content="Which burger would you like?" HorizontalAlignment="Center" Margin="0,138,0,0" VerticalAlignment="Top" FontSize="30" FontFamily="Agency FB" Width="540" HorizontalContentAlignment="Center" FontWeight="Bold" Foreground="FloralWhite" />
        <Button x:Name="btnOptionOne"  Content="Option 1" Click="btnOptionOne_Click" Margin="130,217,474,134" Foreground="FloralWhite" Padding="8,8,8,8"  BorderBrush="DarkRed" FontSize="23" FontFamily="Bahnschrift" >
            <Button.Background>
                <SolidColorBrush Color="Black" Opacity="0.75"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnOptionTwo"  Content="Option 2" Click="btnOptionTwo_Click" Margin="476,217,130,134" Foreground="FloralWhite" Padding="8,8,8,8"  BorderBrush="DarkRed" FontSize="23" FontFamily="Bahnschrift" >
            <Button.Background>
                <SolidColorBrush Color="Black" Opacity="0.75"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnCancel" Content="Cancel" Click="btnCancel_Click" Margin="302,375,302,10" Foreground="FloralWhite" Padding="8,8,8,8"  BorderBrush="DarkRed" FontSize="23" FontFamily="Bahnschrift">
            <Button.Background>
                <SolidColorBrush Color="Black" Opacity="0.75"/>
            </Button.Background>
        </Button>
    </Grid>
</Window>
