<Window x:Class="burger_national_V1.GroupTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:burger_national_V1"
        mc:Ignorable="d"
        Title="The Group Tour" Height="475
        " Width="800" Background="#FF212121">
    <Grid Margin="0,0,0,0">
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/burger-national-logo.png" Stretch="UniformToFill" Opacity="0.505"/>
        </Grid.Background>
        <Label Content="Select your burger options:" HorizontalAlignment="Center" Margin="0,62,0,0" VerticalAlignment="Top" FontSize="30" FontFamily="Bahnschrift" Width="541" HorizontalContentAlignment="Center" Foreground="FloralWhite"/>

        <Label Content="European Burgers:" HorizontalAlignment="Center" Margin="0,122,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Bahnschrift" Foreground="FloralWhite"/>
        <ComboBox Text="Select A European Burger" x:Name="cbxEuropeanOne"  HorizontalAlignment="Left" Margin="130,156,0,0" VerticalAlignment="Top" Width="224" Background="{x:Null}" Foreground="FloralWhite" BorderBrush="Black"/>
        <ComboBox Text="Select A European Burger" x:Name="cbxEuropeanTwo"  HorizontalAlignment="Left" Margin="446,156,0,0" VerticalAlignment="Top" Width="224" Background="{x:Null}" Foreground="FloralWhite" BorderBrush="Black"/>

        <Label Content="Chicken And Other Burgers:" HorizontalAlignment="Center" Margin="0,204,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Bahnschrift" Foreground="FloralWhite"/>
        <ComboBox Text="Select a Chicken and Other Burger" x:Name="cbxChickOtherOne"  HorizontalAlignment="Left" Margin="130,238,0,0" VerticalAlignment="Top" Width="224" Background="{x:Null}" Foreground="FloralWhite" BorderBrush="Black"/>
        <ComboBox Text="Select a Chicken and Other Burger" x:Name="cbxChickOtherTwo"  HorizontalAlignment="Left" Margin="446,238,0,0" VerticalAlignment="Top" Width="224" Background="{x:Null}" Foreground="FloralWhite" BorderBrush="Black"/>
        <Button x:Name="btnOK" Click="btnOK_Click" Content="OK" HorizontalAlignment="Center" Margin="0,294,0,0" VerticalAlignment="Top" Width="116" Height="45" Foreground="FloralWhite" BorderBrush="DarkRed">
            <Button.Background>
                <SolidColorBrush Color="#FF1D1D1D" Opacity="0.33"/>
            </Button.Background>
        </Button>

    </Grid>
</Window>
